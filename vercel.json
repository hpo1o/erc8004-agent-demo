{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix frontend",
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/process",
      "destination": "/api/process.ts"
    },
    {
      "source": "/api/reputation",
      "destination": "/api/reputation.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/api/agent",
      "destination": "/api/agent.ts"
    },
    {
      "source": "/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/",
      "destination": "/frontend/public/index.html"
    },
    {
      "source": "/app.js",
      "destination": "/frontend/public/app.js"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/public/style.css"
    }
  ]
}
