# ── OpenAI image generation ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional override; gpt-image-2 is the supported default.
OPENAI_IMAGE_MODEL=gpt-image-2

# ── Two-wallet ERC-8004/x402 setup ───────────────────────────────────────────
# Agent 1: pays x402, submits reputation, and acts as independent validator.
PAYER_PRIVATE_KEY=0x...

# Agent 2: owns ERC-8004 agentId 2214 and requests validation.
ERC8004_PRIVATE_KEY=0x...

# Pinata JWT for reputation and validation evidence.
PINATA_JWT=eyJ...

# Base Sepolia RPC (optional).
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ── Public-service protection ─────────────────────────────────────────────────
# Strongly recommended on a public/custom domain. Visitors enter this value in
# the Access token field. Leave empty only for a deliberately public demo.
SERVICE_ACCESS_TOKEN=replace-with-a-long-random-value

# Per-IP generation limit.
PROCESS_RATE_LIMIT_MAX=10
PROCESS_RATE_LIMIT_WINDOW_MS=3600000

# Railway sets PORT automatically. Only needed for local development.
PORT=3001
